# Development: a MinIO the application runs, reached as S3 through its own STS endpoint, and the
# development realm. MinIO's root user stands in for the deployment's identity; production has none.
STORAGE_CONNECTION={"kind":"s3","bucket":"graphs","root":"","region":"us-east-1","roleArn":"arn:minio:iam:::role/storage","stsEndpoint":"http://minio:9000","s3Endpoint":"http://localhost:9000"}
AUTH_ISSUER=http://localhost:8080/realms/kanzo
AUTH_CLIENT_ID=kanzo-conformance
AUTH_ORGANIZATION=acme
