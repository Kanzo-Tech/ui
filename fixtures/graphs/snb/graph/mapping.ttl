	rml:iterator "SELECT s.subject AS source, d.subject AS target FROM \"Knowing_known_Person\" AS e JOIN \"Knowing\" AS s ON e._graphArSrcIndex = s._graphArVertexIndex JOIN \"Person\" AS d ON e._graphArDstIndex = d._graphArVertexIndex" ;
	rml:source _:a2 .
_:a2 a rml:Source .
_:a3 rml:reference "source" ;
	rml:termType rml:IRI .
_:a4 rml:predicate <https://ldbc-snb.example/vocab#known> ;
	rml:objectMap _:a5 .
_:a5 rml:reference "target" ;
	rml:termType rml:IRI .
