{
  "name": "@kanzo-tech/ui",
  "version": "0.1.0",
  "description": "Kanzo shared UI — domain-free components over Ark UI and tailwind-variants, themed by tokens.",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/tailwind.css",
    "README.md"
  ],
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./editor": {
      "types": "./dist/editor.d.ts",
      "import": "./dist/editor.js"
    },
    "./table": {
      "types": "./dist/table.d.ts",
      "import": "./dist/table.js"
    },
    "./analytics": {
      "types": "./dist/analytics.d.ts",
      "import": "./dist/analytics.js"
    },
    "./tailwind.css": "./src/tailwind.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "size": "size-limit"
  },
  "//deps": "`tailwind.css` is compiled by the consumer, but its `@plugin` and `@import` resolve from THIS package's directory — under pnpm a consumer's own install is not visible from here. So what the entry names is a dependency, and `tailwindcss` is a required peer: the typography plugin requires `tailwindcss/plugin`, and it must be the consumer's copy, the one compiling the page.",
  "peerDependencies": {
    "@codemirror/autocomplete": "^6.0.0",
    "@codemirror/commands": "^6.0.0",
    "@codemirror/language": "^6.0.0",
    "@codemirror/search": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@kanzo-tech/mosaic": "workspace:*",
    "@lezer/highlight": "^1.0.0",
    "@tanstack/react-table": "^8.0.0",
    "@uwdata/mosaic-core": "^0.32.0",
    "@uwdata/mosaic-plot": "^0.32.0",
    "@uwdata/mosaic-sql": "^0.32.0",
    "@uwdata/vgplot": "^0.32.0",
    "lucide-react": "^1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-table": {
      "optional": true
    },
    "@uwdata/vgplot": {
      "optional": true
    },
    "@uwdata/mosaic-core": {
      "optional": true
    },
    "@uwdata/mosaic-sql": {
      "optional": true
    },
    "@uwdata/mosaic-plot": {
      "optional": true
    },
    "@codemirror/autocomplete": {
      "optional": true
    },
    "@codemirror/commands": {
      "optional": true
    },
    "@codemirror/language": {
      "optional": true
    },
    "@codemirror/search": {
      "optional": true
    },
    "@codemirror/state": {
      "optional": true
    },
    "@codemirror/view": {
      "optional": true
    },
    "@lezer/highlight": {
      "optional": true
    },
    "@kanzo-tech/mosaic": {
      "optional": true
    }
  },
  "dependencies": {
    "@ark-ui/react": "^5.37.2",
    "@internationalized/date": "^3.12.2",
    "@kanzo-tech/theme": "workspace:*",
    "@tailwindcss/typography": "^0.5.20",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tw-animate-css": "^1.4.0",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "@kanzo-tech/mosaic": "workspace:*",
    "@kanzo-tech/testing": "workspace:*",
    "@lezer/highlight": "^1.2.3",
    "@tanstack/react-table": "^8.21.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@uwdata/mosaic-core": "^0.32.0",
    "@uwdata/mosaic-plot": "^0.32.0",
    "@uwdata/mosaic-sql": "^0.32.0",
    "@uwdata/vgplot": "^0.32.0",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rollup-plugin-preserve-directives": "^0.4.0",
    "tailwindcss": "4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kanzo-Tech/ui.git",
    "directory": "packages/ui"
  },
  "homepage": "https://kanzo-tech.github.io/ui",
  "bugs": {
    "url": "https://github.com/Kanzo-Tech/ui/issues"
  },
  "//gauges": "One gauge per published entry, and one per tree-shaken import a consumer meets; `scripts/gauges.mjs` (through `.size-limit.mjs`) is what each measures, and every limit's reason — each raise, dated, with its before and after — is a row on /docs/design, *A gauge per entry, and its raises written here*.",
  "gauges": {
    ".": "51 kB",
    "./editor": "4.7 kB",
    "./table": "3.3 kB",
    "./analytics": "27.5 kB",
    "./analytics { Dashboard }": "34.9 kB",
    ". { Button }": "2 kB"
  }
}
