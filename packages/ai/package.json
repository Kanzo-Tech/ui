{
  "name": "@kanzo-tech/ai",
  "version": "0.1.0",
  "description": "Kanzo AI surfaces — a field the model helps fill (Assist) and a conversation with one (Chat), over the AI SDK through @kanzo-tech/llm. Sibling of @kanzo-tech/ui, not part of it.",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/tailwind.css",
    "README.md"
  ],
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tailwind.css": "./src/tailwind.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "size": "size-limit"
  },
  "//peers": "@kanzo-tech/ui and Ark are required peers rather than dependencies — two copies of Ark would mean two portals and two focus traps. `ai` and `@ai-sdk/react` are REQUIRED peers for the reason @kanzo-tech/llm gives: the host's agent and these components must share one UIMessage, one transport and one useChat. streamdown is a dependency now: Chat renders markdown, and a conversation that draws plain text is not one this package offers.",
  "peerDependencies": {
    "@ai-sdk/react": "^4.0.0",
    "@ark-ui/react": "^5.37.2",
    "@kanzo-tech/ui": "workspace:*",
    "ai": "^7.0.0",
    "lucide-react": ">=1",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "dependencies": {
    "@kanzo-tech/llm": "workspace:*",
    "streamdown": "^2.5.0",
    "tailwind-variants": "^3.2.2"
  },
  "devDependencies": {
    "@ai-sdk/react": "^4.0.129",
    "@ark-ui/react": "^5.37.2",
    "@kanzo-tech/theme": "workspace:*",
    "@kanzo-tech/ui": "workspace:*",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "ai": "^7.0.126",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rollup-plugin-preserve-directives": "^0.4.0"
  },
  "//size-limit": "The root barrel, measured without the peers and dependencies a host already has. Assist and Chat tree-shake apart: a host that only assists fields does not ship the transcript, and the markdown parser comes with Chat alone.",
  "size-limit": [
    {
      "name": "root barrel (JS)",
      "path": "dist/index.js",
      "limit": "20 kB",
      "ignore": [
        "react",
        "react-dom",
        "react/jsx-runtime",
        "@ark-ui/react",
        "@kanzo-tech/ui",
        "@kanzo-tech/llm",
        "lucide-react",
        "tailwind-variants",
        "streamdown",
        "ai",
        "@ai-sdk/react"
      ]
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kanzo-Tech/ui.git",
    "directory": "packages/ai"
  },
  "homepage": "https://kanzo-tech.github.io/ui",
  "bugs": {
    "url": "https://github.com/Kanzo-Tech/ui/issues"
  }
}
