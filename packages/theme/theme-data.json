{
  "radii": {
    "none": "0rem",
    "xs": "0.125rem",
    "sm": "0.25rem",
    "md": "0.5rem",
    "lg": "0.625rem"
  },
  "fonts": {
    "system": "ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
    "geist": "var(--font-geist-sans, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif)",
    "inter": "var(--font-inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif)"
  },
  "monoFonts": {
    "system": "ui-monospace, SFMono-Regular, \"SF Mono\", Menlo, Consolas, \"Liberation Mono\", monospace",
    "geist-mono": "var(--font-geist-mono, ui-monospace, SFMono-Regular, \"SF Mono\", Menlo, Consolas, \"Liberation Mono\", monospace)",
    "jetbrains-mono": "var(--font-jetbrains-mono, ui-monospace, SFMono-Regular, \"SF Mono\", Menlo, Consolas, \"Liberation Mono\", monospace)"
  },
  "densities": {
    "default": "16px",
    "compact": "14px",
    "comfortable": "18px"
  },
  "themes": [
    {
      "name": "bank-dark",
      "dark": true
    },
    {
      "name": "bank-private-dark",
      "dark": true
    },
    {
      "name": "bank-private",
      "dark": false
    },
    {
      "name": "bank",
      "dark": false
    },
    {
      "name": "catppuccin-latte-dark",
      "dark": true
    },
    {
      "name": "catppuccin-latte",
      "dark": false
    },
    {
      "name": "catppuccin-mocha-dark",
      "dark": true
    },
    {
      "name": "catppuccin-mocha",
      "dark": false
    },
    {
      "name": "dracula-dark",
      "dark": true
    },
    {
      "name": "dracula",
      "dark": false
    },
    {
      "name": "kanzo-dark",
      "dark": true
    },
    {
      "name": "kanzo",
      "dark": false
    },
    {
      "name": "monochrome-dark",
      "dark": true
    },
    {
      "name": "monochrome",
      "dark": false
    },
    {
      "name": "nord-dark",
      "dark": true
    },
    {
      "name": "nord",
      "dark": false
    }
  ],
  "prefs": {
    "appearance": {
      "kind": "choice",
      "options": [
        {
          "value": "",
          "label": "System"
        },
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "dark",
          "label": "Dark"
        }
      ],
      "default": "",
      "label": "Appearance",
      "doc": "which side of the document is worn"
    },
    "radius": {
      "kind": "choice",
      "options": [
        {
          "value": "none",
          "label": "none"
        },
        {
          "value": "xs",
          "label": "xs"
        },
        {
          "value": "sm",
          "label": "sm"
        },
        {
          "value": "md",
          "label": "md"
        },
        {
          "value": "lg",
          "label": "lg"
        }
      ],
      "default": "md",
      "attr": "data-radius",
      "source": "themes",
      "label": "Radius",
      "doc": "how round a corner is"
    },
    "font": {
      "kind": "choice",
      "options": [
        {
          "value": "system",
          "label": "System"
        },
        {
          "value": "geist",
          "label": "Geist"
        },
        {
          "value": "inter",
          "label": "Inter"
        }
      ],
      "default": "system",
      "attr": "data-font",
      "source": "themes",
      "label": "Font",
      "doc": "the face body text is set in"
    },
    "monoFont": {
      "kind": "choice",
      "options": [
        {
          "value": "system",
          "label": "System"
        },
        {
          "value": "geist-mono",
          "label": "Geist Mono"
        },
        {
          "value": "jetbrains-mono",
          "label": "JetBrains"
        }
      ],
      "default": "system",
      "attr": "data-mono-font",
      "source": "themes",
      "label": "Mono font",
      "doc": "the face code is set in"
    },
    "density": {
      "kind": "choice",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "compact",
          "label": "Compact"
        },
        {
          "value": "comfortable",
          "label": "Cozy"
        }
      ],
      "default": "default",
      "attr": "data-font-size",
      "source": "themes",
      "label": "Density",
      "doc": "the root size everything scales from"
    },
    "themeByAppearance": {
      "kind": "choice",
      "options": {
        "from": "themes"
      },
      "default": "",
      "attr": "data-theme",
      "source": "document",
      "byAppearance": true,
      "label": "Theme",
      "doc": "which theme is worn on this side"
    }
  },
  "fallbacks": {
    "--secondary-foreground": [
      "--foreground"
    ],
    "--accent-foreground": [
      "--foreground"
    ],
    "--popover": [
      "--card"
    ],
    "--input": [
      "--border"
    ],
    "--field": [
      "--muted"
    ],
    "--faint": [
      "--muted-foreground"
    ],
    "--destructive-foreground": [
      "--destructive"
    ],
    "--info-foreground": [
      "--info"
    ],
    "--success-foreground": [
      "--success"
    ],
    "--warning-foreground": [
      "--warning"
    ],
    "--sidebar": [
      "--popover",
      "--card"
    ],
    "--sidebar-foreground": [
      "--muted-foreground"
    ]
  }
}