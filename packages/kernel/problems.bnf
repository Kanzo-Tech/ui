(* ==========================================================================
   problems.bnf - THE CODES A FAILURE MAY CARRY.

   The one source of the registry. `pnpm --filter @kanzo-tech/kernel gen` writes
   `src/problems.gen.ts` from this file; a server in another language reads the same
   file and generates its own table, so no code is stated twice. It is published
   beside the code. `/docs/design/failure`, *The registry is generated*.

   Reference: RFC 9457 (Problem Details for HTTP APIs). A row is what section 4
   says a problem TYPE definition must document: a type URI, a title, and the HTTP
   status it is used with; `data` is the type's extension members (section 3.2).

   # The grammar

     file    = base { row } .
     base    = "base" string "." .
     row     = "row" code "=" status ";" string ";" data "." .
     code    = word "/" word .
     word    = lower { lower | digit } { "-" ( lower | digit ) { lower | digit } } .
     status  = digit digit digit | "-" .
     data    = "-" | field { "," field } .
     field   = name [ "?" ] ":" ( "number" | "string" ) .
     name    = letter { letter } .
     string  = '"' { any character but '"' } '"' .

   A row is one line. A comment opens with parenthesis-star, closes with star-parenthesis,
   as this one does, and is not nested.

   # What each part is

     base      the type URI's prefix. A row's `type` is the base followed by its code,
               and nothing else: `type` is DERIVED from `code`, never written, so the
               two cannot disagree. It is a tag URI (RFC 4151), the non-resolvable form
               RFC 9457 section 3.1.1 itself names for a type; dereferencing it is not
               possible and not asked for ("consumers SHOULD NOT automatically
               dereference"). A resolvable URL would be encouraged by the RFC, and
               switching to one later is a new identity for every type, a breaking
               change; `/docs/design/kernel` says what would reverse the choice.
     code      `area/kind`. Stable once released: never reworded, never reused. One
               row a code.
     status    the HTTP status where the code crosses a wire (400 to 599), `-` if it
               never does. It is advisory on the wire (RFC 9457 section 3.1.2): the
               response must carry the same status.
     string    the TITLE: a short summary of the problem TYPE (section 3.1.3). It does
               not change from occurrence to occurrence, so it is never the status
               phrase (that is `about:blank`'s title, section 4.2.1, and a coded
               problem has semantics beyond its status) and never the occurrence's
               text, which is `detail`.
     data      the fields of the `data` extension member, `?` when one may be absent.
               `-` when the code carries none.

   A host's own codes (keasy's `rbac/*`) are another file in this grammar through the
   same generator, never a row here.
   ========================================================================== *)

base "tag:kanzo.tech,2026:problem/" .

row engine/unavailable      = -   ; "The engine would not start"             ; after?: number .
row engine/lost             = -   ; "The engine was lost"                    ; reason?: string .
row engine/failed           = -   ; "The engine refused a statement"         ; statement?: string .
row engine/cannot-cancel    = -   ; "The engine cannot stop a statement"     ; - .

row graph/no-webgl          = -   ; "The graph cannot be drawn here"         ; after?: number .
row graph/context-lost      = -   ; "The drawing surface was taken back"     ; - .
row graph/no-positions      = -   ; "The graph has no positions"             ; - .
row graph/nothing-to-draw   = -   ; "The graph is empty"                     ; - .
row graph/too-large         = -   ; "The graph is too large to draw"         ; count: number, limit: number .

row llm/unavailable         = -   ; "The model cannot run here"              ; reason: string .
row llm/truncated           = -   ; "The answer was cut off"                 ; reason?: string .
row llm/silent              = -   ; "The model made no progress"             ; after: number, stage?: string .

row relations/invalid       = -   ; "The relations contradict themselves"    ; type?: string .
row relations/unmatched     = -   ; "A term names nothing in the catalog"    ; term?: string .
row relations/no-step       = -   ; "A path step resolves to nothing"        ; step?: string .

row session/absent          = 401 ; "Nobody is signed in"                    ; - .
row session/unavailable     = 503 ; "The session could not be read"          ; status?: number .
row session/silent          = 504 ; "The session did not answer"             ; after: number .
row session/irrevocable     = 501 ; "The session cannot be revoked"          ; - .

row idp/unreachable         = 502 ; "The identity provider is unreachable"   ; status?: number .
row idp/silent              = 504 ; "The identity provider did not answer"   ; after: number .

row token/exchange-failed   = 502 ; "The token exchange failed"              ; status?: number .
row token/refused           = 401 ; "The token was refused"                  ; status?: number .

row organization/invalid    = 400 ; "The organization is not valid"          ; - .
row organization/denied     = 403 ; "The organization is not permitted"      ; - .

row callback/state-mismatch = 400 ; "The callback does not match"            ; - .
row callback/nonce-mismatch = 400 ; "The callback does not match"            ; - .

row claims/no-subject       = 502 ; "The claims name nobody"                 ; - .

row api/unreachable         = 502 ; "The API is unreachable"                 ; status?: number .
row api/silent              = 504 ; "The API did not answer"                 ; after: number .
