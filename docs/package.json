{
  "name": "@kanzo-tech/docs",
  "private": true,
  "version": "0.0.0",
  "description": "Kanzo UI documentation — Next.js App Router + fumadocs, mirroring Shark UI's docs stack. Doubles as the RSC fixture: Vite ignores \"use client\", so this is the only place the library's client/server boundary is actually exercised.",
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack --port 3100",
    "build": "next build --webpack",
    "start": "next start --port 3100",
    "typecheck": "tsc --noEmit",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@cosmos.gl/graph": "^3.4.0",
    "@duckdb/duckdb-wasm": "1.33.1-dev57.0",
    "@kanzo-tech/palette": "workspace:*",
    "@kanzo-tech/theme": "workspace:*",
    "@kanzo-tech/ui": "workspace:*",
    "@tanstack/react-form": "^1.33.2",
    "@tanstack/react-table": "^8.21.3",
    "@types/n3": "^1.26.1",
    "@uwdata/mosaic-core": "^0.29.2",
    "@uwdata/mosaic-sql": "^0.29.0",
    "@uwdata/vgplot": "^0.29.2",
    "fumadocs-core": "16.9.3",
    "fumadocs-mdx": "15.0.11",
    "fumadocs-ui": "16.9.3",
    "lucide-react": "^1.23.0",
    "n3": "^2.1.1",
    "next": "16.2.7",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shiki": "^4.2.0",
    "zod": "^4.4.3"
  },
  "//deps": "@kanzo-tech/palette is imported only by the palette showcase's SERVER halves, which derive at build time. The RSC boundary is what keeps it out of a browser bundle, not the dependency section.",
  "devDependencies": {
    "@tailwindcss/postcss": "4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^20",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "4",
    "typescript": "^5.7.3"
  }
}
